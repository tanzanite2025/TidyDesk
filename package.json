{
  "name": "tidydesk",
  "private": true,
  "version": "3.4.1",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "npm run build:sidecar && concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:sidecar": "go -C sidecars/apps-cache build -o tidydesk-apps-cache.exe .",
    "prepare:tauri-sidecar": "node scripts/prepare-tauri-sidecar.cjs",
    "build:electron:dir": "npm run build:sidecar && npm run build && electron-builder --win --dir --publish never",
    "build:electron": "npm run build:sidecar && npm run build && electron-builder --win --publish never",
    "build:publish": "npm run build:sidecar && npm run build && electron-builder --win --publish always",
    "verify:packaged-sidecar": "node scripts/verify-packaged-sidecar.cjs",
    "tauri:poc:dev": "npx --yes @tauri-apps/cli@2 dev",
    "tauri:poc:build": "npx --yes @tauri-apps/cli@2 build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "chokidar": "^3.6.0",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.1.7",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tidydesk.app",
    "productName": "TidyDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecars/apps-cache/tidydesk-apps-cache.exe",
        "to": "sidecars/apps-cache/tidydesk-apps-cache.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TidyDesk"
    },
    "publish": {
      "provider": "github",
      "owner": "tanzanite2025",
      "repo": "TidyDesk",
      "releaseType": "release"
    }
  }
}
