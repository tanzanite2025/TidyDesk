{
  "name": "tidydesk",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanzanite2025/TidyDesk.git"
  },
  "build": {
    "publish": {
      "owner": "tanzanite2025",
      "repo": "TidyDesk"
    }
  },
  "scripts": {
    "dev": "npm run tauri:dev",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && npm run check:rust:fmt && npm run check:rust",
    "tauri:preflight": "node scripts/check-tauri-release-env.cjs",
    "tauri:verify-version": "node scripts/check-release-version.cjs",
    "tauri:dev": "tauri dev",
    "tauri:bundle": "npm run tauri:preflight && node scripts/run-tauri-build.cjs",
    "tauri:manifest": "node scripts/generate-tauri-latest-json.cjs",
    "tauri:build": "npm run tauri:bundle && npm run tauri:manifest",
    "tauri:release": "npm run tauri:build",
    "server:package": "node scripts/package-sync-server.cjs",
    "test:web": "vitest run src",
    "test:e2e:install": "npm install --prefix e2e-tests",
    "test:e2e:tauri": "npm test --prefix e2e-tests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
