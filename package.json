{
  "name": "tidydesk",
  "private": true,
  "type": "module",
  "version": "3.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanzanite2025/TidyDesk.git"
  },
  "build": {
    "publish": {
      "owner": "tanzanite2025",
      "repo": "TidyDesk"
    }
  },
  "scripts": {
    "dev": "npm run tauri:dev",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:rust": "set \"CARGO_BUILD_TARGET=x86_64-pc-windows-gnu\" && set \"PATH=%USERPROFILE%\\bin;%PATH%\" && cargo +stable-x86_64-pc-windows-gnu check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && npm run check:rust",
    "tauri:preflight": "node scripts/check-tauri-release-env.cjs",
    "tauri:verify-version": "node scripts/check-release-version.cjs",
    "tauri:dev": "set \"RUSTUP_TOOLCHAIN=stable-x86_64-pc-windows-gnu\" && set \"CARGO_BUILD_TARGET=x86_64-pc-windows-gnu\" && set \"PATH=%USERPROFILE%\\bin;%PATH%\" && tauri dev",
    "tauri:bundle": "npm run tauri:preflight && node scripts/run-tauri-build.cjs",
    "tauri:manifest": "node scripts/generate-tauri-latest-json.cjs",
    "tauri:build": "npm run tauri:bundle && npm run tauri:manifest",
    "tauri:release": "npm run tauri:build",
    "test:e2e:install": "npm install --prefix e2e-tests",
    "test:e2e:tauri": "npm test --prefix e2e-tests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^8.0.16"
  }
}
