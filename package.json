{
  "name": "tidydesk",
  "private": true,
  "version": "3.0.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:sidecar": "go -C sidecars/apps-cache build -o tidydesk-apps-cache.exe .",
    "prepare:tauri-sidecar": "node scripts/prepare-tauri-sidecar.cjs",
    "tauri:preflight": "node scripts/check-tauri-release-env.cjs",
    "tauri:dev": "npx --yes @tauri-apps/cli@2 dev",
    "tauri:build": "npm run tauri:preflight && npx --yes @tauri-apps/cli@2 build",
    "tauri:manifest": "node scripts/generate-tauri-latest-json.cjs",
    "tauri:release": "npm run tauri:build && npm run tauri:manifest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "chokidar": "^3.6.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.11"
  }
}
