{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TidyDesk Tauri PoC",
  "version": "0.1.0",
  "identifier": "com.tidydesk.tauri-poc",
  "build": {
    "beforeDevCommand": "npm run prepare:tauri-sidecar && npm run dev",
    "beforeBuildCommand": "npm run prepare:tauri-sidecar && npm run build",
    "devUrl": "http://localhost:3000?mode=tauri-poc",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TidyDesk Tauri PoC",
        "width": 980,
        "height": 680,
        "url": "index.html?mode=tauri-poc",
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "../build/icon.ico",
      "iconAsTemplate": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis",
    "icon": [
      "../build/icon.ico"
    ],
    "externalBin": [
      "sidecars/apps-cache/tidydesk-apps-cache"
    ]
  }
}
